# Environment
NODE_ENV=development

# Server
PORT=3001

# Database
MONGODB_URI=mongodb://localhost:27017/clinic-management
MONGODB_DB_NAME=clinic-management

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_REFRESH_EXPIRES_IN=30d

# API Documentation
API_TITLE=Clinic Management System API
API_DESCRIPTION=Comprehensive API documentation for Clinic Management System
API_VERSION=1.0
API_PREFIX=/api
